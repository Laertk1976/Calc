{
  "expo": {
    "name": "Calculator",
    "slug": "calc",
    "icon": "./assets/icon.png",
     "android": {
      "package": "com.example.calc",
      "versionCode": 11,
       "googleServicesFile": "./google-services.json"
    },
    "scheme": [
      "com.example.calc",
      "com.googleusercontent.apps.186668101668-d2preo1to754tg8edidaod4v1lfp8gvu"
    ],
    "version": "1.0.8",
    "orientation": "portrait",
    "userInterfaceStyle": "dark",
    "web": {
      "bundler": "metro"
    },
    "plugins": [
      "expo-web-browser",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#111827",
          "resizeMode": "contain"
        }
      ],
      "expo-audio"
    ]
  }
}
